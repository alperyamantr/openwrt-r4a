#!/bin/sh
# openwrt-r4a/files/etc/rc.local
# Ported 1:1 from openwrt-c50v6's rc.local (HTB QoS structure/values kept
# identical). Two things intentionally changed vs C50v6:
#   - IFACE / rate: C50v6 was tuned for an 8Mbps line (eth0.2, 7200kbit).
#     TODO: verify real WAN interface name via `ip a` after first boot, and
#     set RATE below to your actual line speed (300Mbps here -> ~270000kbit,
#     leave ~10% headroom off the nominal rate).
#   - The old "HaGeZi Guncelleme" background block at the end was removed —
#     that's now luci-app-adblock-fast's job (configure the Hagezi Light URL
#     via LuCI after first boot; the package's rewritten 1.2.x core handles
#     its own scheduling, don't reintroduce a manual wget loop for it).

chmod +x /opt/zapret/nfqws 2>/dev/null

# Gercek WAN Arayuzu
IFACE="eth1"          # R4A WAN: native eth1 port
RATE="270000kbit"     # TODO: set to (line speed in Mbps * 900)kbit -- default=300Mbps
VIP_RATE="300kbit"    # unchanged from C50v6 — still enough guaranteed BW for game/voice

# Alias Tanimlama (SSH'ta 'cs2' veya 'qos' yazip izlemek icin)
if ! grep -q "alias qos=" /etc/profile; then
    echo "alias qos='tc -s class show dev $IFACE'" >> /etc/profile
    echo "alias cs2='tc -s class show dev $IFACE'" >> /etc/profile
fi

# Temizlik
tc qdisc del dev $IFACE root 2>/dev/null
nft delete table inet cs2_qos 2>/dev/null

# Ana HTB Koku (Burst: 6400b)
tc qdisc add dev $IFACE root handle 1: htb default 11
tc class add dev $IFACE parent 1: classid 1:1 htb rate $RATE ceil $RATE burst 6400b cburst 6400b

# 1:10 - OYUN / CANLI / VIP SINIFI (prio 0)
tc class add dev $IFACE parent 1:1 classid 1:10 htb rate $VIP_RATE ceil $RATE prio 0 quantum 1514 burst 3200b cburst 3200b
tc qdisc add dev $IFACE parent 1:10 handle 10: fq_codel limit 1024 flows 128 quantum 300 target 5ms interval 40ms

# 1:11 - GENEL EV TRAFIGI (prio 1)
tc class add dev $IFACE parent 1:1 classid 1:11 htb rate $RATE ceil $RATE prio 1 quantum 1514 burst 6400b cburst 6400b
tc qdisc add dev $IFACE parent 1:11 handle 20: fq_codel limit 10240 flows 1024 quantum 1514

# --- VIP FILTRELERI (aynen tasindi) ---

# 1. CS2 & Steam SDR (27000-27095)
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 27000 0xffe0 flowid 1:10
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 27032 0xffe0 flowid 1:10
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 27064 0xffe0 flowid 1:10

# 2. Voice & Relay (Steam Voice, Discord UDP, WhatsApp)
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 3478 0xffff flowid 1:10
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 4379 0xfffe flowid 1:10

# 3. Mobil Oyunlar (5000-5500, 8000-9000, 10000-20000)
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 5000 0xfe00 flowid 1:10
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 8000 0xfc00 flowid 1:10
tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 match ip protocol 17 0xff match ip dport 10000 0xc000 flowid 1:10

exit 0
