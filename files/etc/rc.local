#!/bin/sh
# openwrt-r4a/files/etc/rc.local
# Xiaomi Mi Router 4A Gigabit Edition (MT7621A) - HTB QoS & Traffic Shaping

chmod +x /opt/zapret/nfqws 2>/dev/null

# WAN Arayuzu
IFACE="wan"          # R4A DSA WAN port
RATE="7200kbit"      # 8 Mbps upload hattina gore %90 bufferbloat optimizasyonu
VIP_RATE="300kbit"   # Oyun ve ses trafigi icin garantili bant

# Alias Tanimlama (SSH'ta 'cs2' veya 'qos' yazip izlemek icin)
if ! grep -q "alias qos=" /etc/profile; then
    echo "alias qos='tc -s class show dev $IFACE'" >> /etc/profile
    echo "alias cs2='tc -s class show dev $IFACE'" >> /etc/profile
fi

# Temizlik
tc qdisc del dev $IFACE root 2>/dev/null
nft delete table inet cs2_qos 2>/dev/null

# Ana HTB Koku (Burst: 6400b)
tc qdisc add dev $IFACE root handle 1: htb default 11
tc class add dev $IFACE parent 1: classid 1:1 htb rate $RATE ceil $RATE burst 6400b cburst 6400b

# 1:10 - OYUN / CANLI / VIP SINIFI (prio 0)
tc class add dev $IFACE parent 1:1 classid 1:10 htb rate $VIP_RATE ceil $RATE prio 0 quantum 1514 burst 3200b cburst 3200b
tc qdisc add dev $IFACE parent 1:10 handle 10: fq_codel limit 1024 flows 128 quantum 300 target 5ms interval 40ms

# 1:11 - GENEL TRAFIK (prio 1)
tc class add dev $IFACE parent 1:1 classid 1:11 htb rate $RATE ceil $RATE prio 1 quantum 1514 burst 6400b cburst 6400b
tc qdisc add dev $IFACE parent 1:11 handle 20: cake bandwidth $RATE nat

# VIP filtresi: UDP + dport
vip() {
    tc filter add dev $IFACE parent 1: protocol ip prio 1 u32 \
        match ip protocol 17 0xff match ip dport "$1" "$2" flowid 1:10
}

# CS2 & Steam SDR: 26976-27103
vip 0x6960 0xffe0
vip 0x6980 0xffe0
vip 0x69a0 0xffe0
vip 0x69c0 0xffe0

# Voice / relay: STUN 3478, 4379-4380
vip 3478 0xffff
vip 4379 0xffff
vip 4380 0xffff

# Mobil oyunlar: 4992-5503
vip 0x1380 0xff80
vip 0x1400 0xff00
vip 0x1500 0xff80

# Mobil oyunlar: 8000-9215
vip 0x1f40 0xffc0
vip 0x1f80 0xff80
vip 0x2000 0xfc00

# Mobil oyunlar: 10000-20479
vip 0x2710 0xfff0
vip 0x2720 0xffe0
vip 0x2740 0xffc0
vip 0x2780 0xff80
vip 0x2800 0xf800
vip 0x3000 0xf000
vip 0x4000 0xf000

exit 0