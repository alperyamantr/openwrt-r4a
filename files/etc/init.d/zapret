#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

FLOWOFFLOAD="software"
QUIC_MODE="block"
WAN_IF="wan"
LAN_IF="br-lan"
QUEUE_PKTS=6
NFQWS_BIN="/opt/zapret/nfqws"
FAKE_DIR="/opt/zapret/files/fake"

start_service() {
    modprobe -q nfnetlink_queue 2>/dev/null

    sysctl -w net.netfilter.nf_conntrack_acct=1 >/dev/null 2>&1 || true
    sysctl -w net.netfilter.nf_conntrack_max=16384 >/dev/null 2>&1 || true
    sysctl -w net.core.netdev_max_backlog=2048 >/dev/null 2>&1 || true
    sysctl -w net.netfilter.nf_conntrack_udp_timeout_stream=60 >/dev/null 2>&1 || true

    if [ ! -d "$FAKE_DIR" ] && [ -d "/etc/zapret/fake" ]; then
        FAKE_DIR="/etc/zapret/fake"
    fi
    [ -d "$FAKE_DIR" ] || mkdir -p "$FAKE_DIR" 2>/dev/null || true

    local FAKE_TLS=""
    local FAKE_DISCORD=""
    local FAKE_STUN=""
    local FAKE_QUIC=""

    [ -s "$FAKE_DIR/tls_clienthello_www_google_com.bin" ] && \
        FAKE_TLS="--dpi-desync-fake-tls=$FAKE_DIR/tls_clienthello_www_google_com.bin"

    [ -s "$FAKE_DIR/discord-ip-discovery-with-port.bin" ] && \
        FAKE_DISCORD="--dpi-desync-fake-unknown-udp=$FAKE_DIR/discord-ip-discovery-with-port.bin"

    [ -s "$FAKE_DIR/stun.bin" ] && \
        FAKE_STUN="--dpi-desync-fake-unknown-udp=$FAKE_DIR/stun.bin"

    [ -s "$FAKE_DIR/quic_initial_www_google_com.bin" ] && \
        FAKE_QUIC="--dpi-desync-fake-quic=$FAKE_DIR/quic_initial_www_google_com.bin"

    local COMMON_ARGS="--user=daemon --bind-fix4 \
        --filter-tcp=443 \
        --dpi-desync=fake,split \
        --dpi-desync-split-pos=1 \
        --dpi-desync-ttl=3 \
        --dpi-desync-repeats=1 \
        --dpi-desync-fooling=badsum \
        $FAKE_TLS \
        --dpi-desync-cutoff=d3 \
        --new \
        --filter-tcp=80 \
        --dpi-desync=fake,split \
        --dpi-desync-split-pos=method+2 \
        --dpi-desync-ttl=4 \
        --dpi-desync-repeats=1 \
        --dpi-desync-fooling=badsum \
        --new \
        --filter-udp=19294-19344,50000-60000 \
        --dpi-desync=fake \
        --dpi-desync-ttl=4 \
        --dpi-desync-repeats=1 \
        --dpi-desync-any-protocol \
        --dpi-desync-cutoff=n2 \
        $FAKE_DISCORD \
        --new \
        --filter-udp=3478-3480,4379-4380 \
        --dpi-desync=fake \
        --dpi-desync-ttl=4 \
        --dpi-desync-repeats=1 \
        --dpi-desync-any-protocol \
        --dpi-desync-cutoff=n2 \
        $FAKE_STUN"

    if [ "$QUIC_MODE" = "desync" ]; then
        COMMON_ARGS="$COMMON_ARGS \
            --new \
            --filter-udp=443 \
            --dpi-desync=fake \
            --dpi-desync-ttl=3 \
            --dpi-desync-repeats=1 \
            --dpi-desync-any-protocol \
            --dpi-desync-cutoff=n2 \
            $FAKE_QUIC"
    fi

    procd_open_instance zapret1
    procd_set_param command $NFQWS_BIN --qnum=80 $COMMON_ARGS
    procd_set_param respawn 60 10 5
    procd_set_param oom_score_adj -500
    procd_close_instance

    procd_open_instance zapret2
    procd_set_param command $NFQWS_BIN --qnum=81 $COMMON_ARGS
    procd_set_param respawn 60 10 5
    procd_set_param oom_score_adj -500
    procd_close_instance

    nft delete table inet zapret 2>/dev/null || true
    nft add table inet zapret 2>/dev/null || true
    nft add chain inet zapret forward '{ type filter hook forward priority -150; policy accept; }' 2>/dev/null || true

    nft add set inet zapret udp_ports '{ type inet_service; flags interval; }' 2>/dev/null || true
    nft add element inet zapret udp_ports '{ 19294-19344, 50000-60000, 3478-3480, 4379-4380 }' 2>/dev/null || true

    local BYPASS_IPS="/etc/zapret-bypass-ips.txt"
    if [ -f "$BYPASS_IPS" ]; then
        while IFS= read -r ip; do
            ip="$(printf '%s' "$ip" | tr -d '\r' | tr -d ' ')"
            case "$ip" in
                ""|\#*) continue ;;
                *:*) nft add rule inet zapret forward ip6 daddr "$ip" accept 2>/dev/null ;;
                *)   nft add rule inet zapret forward ip daddr "$ip" accept 2>/dev/null ;;
            esac
        done < "$BYPASS_IPS"
    fi

    if [ "$QUIC_MODE" = "block" ]; then
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol udp udp dport 443 reject with icmp type port-unreachable 2>/dev/null || \
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol udp udp dport 443 reject 2>/dev/null || true
    fi

    nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 443 ct original packets 1-$QUEUE_PKTS queue flags bypass,fanout to 80-81 2>/dev/null
    nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 80 ct original packets 1-$QUEUE_PKTS queue flags bypass,fanout to 80-81 2>/dev/null
    nft add rule inet zapret forward oifname "$WAN_IF" ip protocol udp udp dport @udp_ports ct original packets 1-$QUEUE_PKTS queue flags bypass,fanout to 80-81 2>/dev/null

    if [ "$FLOWOFFLOAD" = "software" ]; then
        nft add flowtable inet zapret ft "{ hook ingress priority 0; devices = { $LAN_IF, $WAN_IF }; }" 2>/dev/null || true
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 443 ct original packets ">$QUEUE_PKTS" flow add @ft 2>/dev/null
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 80 ct original packets ">$QUEUE_PKTS" flow add @ft 2>/dev/null
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol udp udp dport @udp_ports ct original packets ">$QUEUE_PKTS" flow add @ft 2>/dev/null
    fi
}

stop_service() {
    nft delete table inet zapret 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "zapret"
    procd_add_reload_interface_trigger "$WAN_IF"
}
