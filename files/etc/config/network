
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option packet_steering '1'
	option udp_conntrack_timeout '180'
	option udp_conntrack_timeout_stream '180'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.1.1/24'
	option ipv6 'off'
	option metric '99'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option peerdns '0'
	option ipv6 '0'
	option mtu '1500'
	option metric '10'
	list dns '94.140.14.14'
	list dns '94.140.15.15'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	option ipv6 '0'
