# openwrt-r4a root .config
# SADECE TARGET - paket secimi profiles/packages.txt'ten yonetilir (prepare.sh).
# Bu dosya dogrudan build'de kullanilmaz; r4a-gigabit.config asil kaynaktir.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-4a-gigabit=y
